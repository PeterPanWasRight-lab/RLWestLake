%% main_sarsa.m
% 用于测试 SarsaValue 类的基于值函数的近似算法
% 包含与 PolicyIteration 结果的对比

clear; close all; clc;

%% 1. 环境设置 (Standard 5x5 Grid)
% x_len = 5; y_len = 5;
% start = [1, 1]; final = [3, 4];
% obs = [2,2; 3,2; 3,3; 2,4; 4,4; 2,5];

x_len = 2; y_len = 3;
start = [1, 1]; final = [2,3];
obs = [2,2];

% 实例化环境
env = GridWorld(x_len, y_len, start, final, obs);

% !关键设置: 将撞墙/障碍物惩罚设为 -1 (与参考代码保持一致，避免数值差异)
% env.Reward_Forbidden = -1;    % 会导致某些位置的agent选择直接冒险穿过障碍物（因为扣分很小）

%% 2. (可选) 计算基准真值 (Ground Truth)
% 使用 PolicyIterationAgent 计算 ε-greedy (epsilon=0.1) 下的精确状态价值
% 这用于验证 Sarsa 学习到的价值是否准确
fprintf('正在计算基准真值 (Policy Iteration)...\n'); %[output:431b6753]

gamma = 0.9;
epsilon_eval = 0.1; % 评估时的探索率，需与 Sarsa 训练时保持一致以便对比
pi_agent = PolicyIterationAgent(env.State_Space_Size, 5, gamma, 100, 10);

% % 计算精确的 V_pi
% V_exact = pi_agent.evaluate_epsilon_greedy_policy(env, epsilon_eval, 800);
% V_table_exact = reshape(V_exact, x_len, y_len);
% 
% fprintf('基准真值计算完成。\n');
% env.plot_values(V_exact)
%%
% 训练
pi_agent.train(env); %[output:2fa43c77]

% 结果
[V, Pol] = pi_agent.get_results();

% 打印验证
final_idx = env.coord2idx(final);
target_val = V(final_idx);
fprintf('终点价值: %.2f (预期 10.00)\n', target_val); %[output:294e0197]

% 绘图
env.plot_values(V); %[output:5e50e386]
env.plot_policy(Pol);  % 暂时不能绘制概率策略 %[output:117ff60a]
env.plot_3d_bar_chart(V); %[output:81417dd9]
V_table_exact = reshape(V, x_len, y_len);
%%

%% 3. SarsaValue Agent 设置与训练
% 重新重置环境对象以防干扰（可选）
env = GridWorld(x_len, y_len, start, final, obs);
% env.Reward_Forbidden = -1;

% 参数设置
basis_type = 'fourier'; % 使用傅里叶基函数  %由于加入了action 将使得值函数不好可视化
gamma = 0.9;
episodes = 10000;       % 训练回合数
epsilon = 0.1;          % 探索率 (需与上面基准计算一致)
max_steps = 200;        % 防止死循环的最大步数

% 实例化 Agent
fprintf('初始化 SarsaValue Agent (Basis: %s)...\n', basis_type); %[output:7f7f9af2]
agent = SarsaValue(env, basis_type, gamma);

% 开始训练
fprintf('开始训练 Sarsa (Episodes: %d, Epsilon: %.1f)...\n', episodes, epsilon); %[output:7593ee98]
agent.train(episodes, epsilon, max_steps); %[output:64a00b44]
fprintf('训练完成。\n'); %[output:07b5f2ab]
%%

%% 4. 绘图与结果分析

% 4.1 绘制权重收敛曲线
agent.plot_omega_history(); %[output:84295541]

% 4.2 绘制学习到的价值曲面 (Surface)
fig_handle = agent.plot_surface(); %[output:9af06bdc]

% 4.3 [核心对比] 将精确值 (V_exact) 以散点形式叠加在曲面上
% 如果 Sarsa 学习得好，散点应该紧贴曲面
[m, n] = size(V_table_exact);
[Y, X] = meshgrid(1:n, 1:m); % 注意 GridWorld 的坐标定义通常 X对应列, Y对应行

figure(fig_handle); 
hold on; %[output:9af06bdc]
% 绘制红色散点表示真值
scatter3(X(:), Y(:), V_table_exact(:), 60, 'r', 'filled', 'MarkerEdgeColor', 'k'); %[output:9af06bdc]
legend('Learned Surface (Sarsa)', 'Ground Truth (Policy Iteration)'); %[output:9af06bdc]
title(['Sarsa Value Approximation vs Ground Truth (Basis: ' basis_type ')']); %[output:9af06bdc]
hold off; %[output:9af06bdc]

% 4.4 绘制漂亮的 3D 柱状图 (显示 Sarsa 学习到的 V)
% 需要先计算出所有状态的 V(s) = max_a Q(s,a)
V_learned = zeros(env.State_Space_Size, 1);
for i = 1:env.State_Space_Size
    coord = env.idx2coord(i);
    qs = zeros(1, agent.num_actions);
    for a = 1:agent.num_actions
        qs(a) = agent.get_q_value(coord(1), coord(2), a, agent.omega);
    end
    V_learned(i) = max(qs);
end

env.plot_3d_bar_chart(abs(V_learned)); %[output:325f83c5]
title('Sarsa Learned State Values (3D Bar)'); %[output:325f83c5]

%% 5. 简单验证终点价值
target_idx = env.coord2idx(final);
fprintf('\n--- 验证 ---\n'); %[output:7cc9d53e]
fprintf('终点坐标 (%d, %d) 的精确价值: %.4f\n', final(1), final(2), V(target_idx)); %[output:5a47dd99]
fprintf('终点坐标 (%d, %d) 的学习价值: %.4f\n', final(1), final(2), V_learned(target_idx)); %[output:2b3d9d31]



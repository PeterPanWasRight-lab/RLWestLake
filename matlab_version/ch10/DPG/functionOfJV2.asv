% ===== 离散LQR值函数曲面与山谷线可视化 =====
clear; clc; close all;

% 系统参数（一维系统示例）
A = 0.8;        % 系统矩阵 
B = 1;          % 控制矩阵 
Q = 1;          % 状态权重 
R = 1;          % 控制权重 
x0 = 5;         % 初始状态 
N = 10;         % 总时间步长 

% === 1. 逆向递推求解P_k（动态规划核心） ===
P = zeros(1, N+1);  % 初始化P_k序列
P(N+1) = Q;         % 终端条件P_N=Q_N [1](@ref)

% Riccati逆向递推 [1,2](@ref)
for k = N:-1:1
    K_k = (R + B'*P(k+1)*B) \ (B'*P(k+1)*A);  % 时变增益
    P(k) = Q + A'*P(k+1)*A - A'*P(k+1)*B*K_k; % Riccati方程
end

% === 2. 创建状态-时间网格 ===
x_range = linspace(-10, 10, 50);   % 状态范围
k_range = 1:N;                     % 时间步范围
[X, K] = meshgrid(x_range, k_range);

% === 3. 计算值函数曲面 V_k(x) ===
V = zeros(size(X));
for i = 1:length(k_range)
    k = k_range(i);
    V(i, :) = P(k) * (x_range).^2;  % V_k(x) = x^T P_k x [1](@ref)
end

% === 4. 计算山谷线（理论最小值路径） ===
% 山谷线即V_k(x)的最小值轨迹 - 对于二次型函数，最小值在x=0处 [19](@ref)
valley_line = zeros(size(k_range));  % x=0就是山谷线

% === 5. 可视化 ===
figure('Color','w', 'Position',[100,100,800,600]); %[output:5b657146]
hold on; grid on; view(3); %[output:5b657146]

% 绘制值函数曲面
surf(X, K, V, 'FaceAlpha',0.7, 'EdgeColor','none'); %[output:5b657146]
colormap(jet); %[output:5b657146]

% 绘制山谷线 (x=0)
plot3(zeros(size(k_range)), k_range, valley_line, 'r-', 'LineWidth',3,... %[output:5b657146]
    'DisplayName','山谷线 (x=0)'); %[output:5b657146]

% 标记实际最优轨迹
x_opt = zeros(1,N);
x_opt(1) = x0;
for k = 1:N-1
    K_k = (R + B'*P(k+1)*B) \ (B'*P(k+1)*A);
    u_opt = -K_k * x_opt(k);
    x_opt(k+1) = A*x_opt(k) + B*u_opt;
    plot3(x_opt(k), k, P(k)*x_opt(k)^2, 'ro',... %[output:5b657146]
        'MarkerFaceColor','y', 'MarkerSize',8); %[output:5b657146]
end

% 标注关键点
text(x0, 1, P(1)*x0^2+5, sprintf('起点\nx_0=%.1f',x0),... %[output:5b657146]
    'FontSize',10, 'Color','b', 'HorizontalAlignment','center'); %[output:5b657146]
text(0, N/2, 0, '山谷线: x=0\n(V_k最小值轨迹)',... %[output:5b657146]
    'FontSize',10, 'BackgroundColor','w', 'HorizontalAlignment','center'); %[output:5b657146]

% 坐标轴标签
xlabel('状态 x', 'FontWeight','bold'); %[output:5b657146]
ylabel('时间步 k', 'FontWeight','bold'); %[output:5b657146]
zlabel('值函数 V_k(x)', 'FontWeight','bold'); %[output:5b657146]
title('离散LQR值函数曲面 V_k(x)=x^TP_kx', 'FontSize',14, 'FontWeight','bold'); %[output:5b657146]
colorbar; %[output:5b657146] %[output:3667f03d]

%%
% ===== 离散LQR值函数曲面与山谷线可视化（扩展版） =====
clear; clc; close all;

% 系统参数（一维系统示例）
A = 0.8;        % 系统矩阵 
B = 1;          % 控制矩阵 
Q = 1;          % 状态权重 
R = 1;          % 控制权重 
x0 = 5;         % 初始状态 
N = 10;         % 总时间步长 

% === 1. 逆向递推求解P_k（动态规划核心） ===
P = zeros(1, N+1);  % 初始化P_k序列
P(N+1) = Q;         % 终端条件P_N=Q_N

% Riccati逆向递推
K_opt = zeros(1, N);  % 存储最优控制增益
for k = N:-1:1
    K_opt(k) = (R + B'*P(k+1)*B) \ (B'*P(k+1)*A);  % 时变增益
    P(k) = Q + A'*P(k+1)*A - A'*P(k+1)*B*K_opt(k); % Riccati方程
end

% === 2. 前向仿真计算最优轨迹 ===
x_opt = zeros(1, N+1);
u_opt = zeros(1, N);
x_opt(1) = x0;

for k = 1:N
    u_opt(k) = -K_opt(k) * x_opt(k);
    if k < N
        x_opt(k+1) = A * x_opt(k) + B * u_opt(k);
    end
end

% === 3. 创建状态-时间网格 ===
x_range = linspace(-10, 10, 50);   % 状态范围
k_range = 1:N;                     % 时间步范围
[X, K] = meshgrid(x_range, k_range);

% === 4. 计算状态值函数曲面 V_k(x) ===
V_x = zeros(size(X));
for i = 1:length(k_range)
    k = k_range(i);
    V_x(i, :) = P(k) * (x_range).^2;  % V_k(x) = x^T P_k x
end

% === 5. 创建控制-时间网格并计算控制值函数 ===
u_range = linspace(-8, 8, 50);     % 控制输入范围
[U, K_u] = meshgrid(u_range, k_range(1:N-1));  % 注意：最后一时刻无控制

% 控制值函数：Q_k(x_k, u) = x_k^T Q x_k + u^T R u + V_{k+1}(x_{k+1})
V_u = zeros(size(U));

for i = 1:size(K_u, 1)  % 遍历时间步 %[output:group:2d6c2baa]
    k = K_u(i, 1);
    for j = 1:size(U, 2)  % 遍历控制输入
        u = U(i, j);
        x_k = x_opt(k);  % 当前状态
        x_next = A * x_k + B * u;  % 下一状态
        V_u(i, j) = x_k^T * Q * x_k + u^T * R * u + P(k+1) * x_next^2; %[output:7cd73e57]
    end
end %[output:group:2d6c2baa]

% === 6. 可视化 ===
figure('Color','w', 'Position',[100,100,1200,500]);

% 子图1：状态-时间-值函数曲面
subplot(1,2,1);
hold on; grid on; view(3);

% 绘制状态值函数曲面
surf(X, K, V_x, 'FaceAlpha',0.7, 'EdgeColor','none');
colormap(jet);

% 绘制山谷线 (x=0)
plot3(zeros(size(k_range)), k_range, zeros(size(k_range)), 'r-', ...
    'LineWidth',3, 'DisplayName','山谷线 (x=0)');

% 标记最优轨迹
for k = 1:N-1
    plot3(x_opt(k), k, P(k)*x_opt(k)^2, 'ro', ...
        'MarkerFaceColor','y', 'MarkerSize',8);
end

% 连接最优轨迹
plot3(x_opt(1:N-1), 1:N-1, P(1:N-1).*x_opt(1:N-1).^2, 'r--', ...
    'LineWidth',1.5, 'DisplayName','最优轨迹');

% 标注
text(x0, 1, P(1)*x0^2+5, sprintf('起点\nx_0=%.1f',x0), ...
    'FontSize',10, 'Color','b', 'HorizontalAlignment','center');
text(0, N/2, 0, '山谷线: x=0\n(V_k最小值轨迹)', ...
    'FontSize',10, 'BackgroundColor','w', 'HorizontalAlignment','center');

xlabel('状态 x', 'FontWeight','bold');
ylabel('时间步 k', 'FontWeight','bold');
zlabel('值函数 V_k(x)', 'FontWeight','bold');
title('状态空间：V_k(x) = x^TP_kx', 'FontSize',12, 'FontWeight','bold');
colorbar;
legend('Location','best');

% 子图2：控制-时间-值函数曲面
subplot(1,2,2);
hold on; grid on; view(3);

% 绘制控制值函数曲面
surf(U, K_u, V_u, 'FaceAlpha',0.7, 'EdgeColor','none');
colormap(jet);

% 绘制最优控制轨迹
for k = 1:N-1
    % 当前控制值对应的Q函数值
    x_k = x_opt(k);
    u_k = u_opt(k);
    Q_val = x_k^T * Q * x_k + u_k^T * R * u_k + P(k+1) * (A*x_k + B*u_k)^2;
    
    plot3(u_k, k, Q_val, 'ro', 'MarkerFaceColor','y', 'MarkerSize',8);
end

% 连接最优控制轨迹
plot3(u_opt(1:N-1), 1:N-1, ...
    x_opt(1:N-1).^2.*Q + u_opt(1:N-1).^2.*R + ...
    P(2:N).*(A*x_opt(1:N-1) + B*u_opt(1:N-1)).^2, ...
    'r--', 'LineWidth',1.5, 'DisplayName','最优控制');

% 在每个时间步标记最小值位置
for k = 1:N-1
    % 找到理论最优控制：u^* = -K_k * x_k
    plot3([u_opt(k) u_opt(k)], [k k], [0 V_u(k, :)], 'g:', 'LineWidth',1);
end

xlabel('控制输入 u', 'FontWeight','bold');
ylabel('时间步 k', 'FontWeight','bold');
zlabel('Q函数 Q_k(x_k, u)', 'FontWeight','bold');
title('控制空间：Q_k(x_k, u) = x_k^TQx_k + u^TRu + V_{k+1}(x_{k+1})', ...
    'FontSize',12, 'FontWeight','bold');
colorbar;
legend('Location','best');

% 添加总标题
sgtitle('离散LQR：状态-控制对偶空间可视化', 'FontSize',14, 'FontWeight','bold');

% === 7. 额外：单独显示控制轨迹和状态轨迹 ===
figure('Color','w', 'Position',[100,100,800,300]);

subplot(1,2,1);
stairs(1:N, [x_opt(1:N) 0], 'b-', 'LineWidth',2);
hold on;
plot(1:N, x_opt(1:N), 'ro', 'MarkerFaceColor','r', 'MarkerSize',6);
grid on;
xlabel('时间步 k');
ylabel('状态 x_k');
title('最优状态轨迹');
legend('状态轨迹', '位置点');

subplot(1,2,2);
stairs(1:N-1, u_opt, 'b-', 'LineWidth',2);
hold on;
plot(1:N-1, u_opt, 'ro', 'MarkerFaceColor','r', 'MarkerSize',6);
grid on;
xlabel('时间步 k');
ylabel('控制 u_k');
title('最优控制序列');
legend('控制序列', '控制点');

% === 8. 打印结果 ===
fprintf('=== 离散LQR仿真结果 ===\n');
fprintf('系统矩阵 A = %.2f\n', A);
fprintf('控制矩阵 B = %.2f\n', B);
fprintf('初始状态 x0 = %.2f\n\n', x0);

fprintf('时间步  状态 x_k    控制 u_k    增益 K_k\n');
fprintf('-----------------------------------------\n');
for k = 1:N-1
    fprintf('  k=%d   %8.4f   %8.4f   %8.4f\n', ...
        k, x_opt(k), u_opt(k), K_opt(k));
end
fprintf('  k=%d   %8.4f       -         -\n', N, x_opt(N));

fprintf('\n稳态Riccati解: P_∞ = %.4f\n', P(1));
fprintf('稳态控制增益: K_∞ = %.4f\n', K_opt(1));

% 计算稳态收敛性
converged = all(abs(P(1:end-1) - P(1)) < 1e-3);
if converged
    fprintf('Riccati解在%d步内收敛到稳态\n', N);
else
    fprintf('Riccati解尚未完全收敛\n');
end


%---
%[output:4a6a6c64]
%   data: {"dataType":"text","outputData":{"text":"最优反馈增益 K_lqr:\n","truncated":false}}
%---
%[output:1a005d9c]
%   data: {"dataType":"text","outputData":{"text":"    0.7064    0.9455\n\n","truncated":false}}
%---
%[output:0f50c31a]
%   data: {"dataType":"text","outputData":{"text":"--- 开始 DPG 策略梯度优化 ---\n","truncated":false}}
%---
%[output:46586ec5]
%   data: {"dataType":"text","outputData":{"text":"--- DPG 收敛结果 ---\n","truncated":false}}
%---
%[output:5e60d361]
%   data: {"dataType":"text","outputData":{"text":"最终 DPG 学习得到的增益 K_dpg:\n","truncated":false}}
%---
%[output:2da1895e]
%   data: {"dataType":"text","outputData":{"text":"    0.7064    0.9455\n\n","truncated":false}}
%---
%[output:6e683eac]
%   data: {"dataType":"text","outputData":{"text":"K_dpg 与 K_lqr 的最终误差 (Frobenius Norm): 8.950904e-16\n\n","truncated":false}}

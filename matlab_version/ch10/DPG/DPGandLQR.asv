% dpg_lqr_convergence.m
% Q函数采用LQR的价值函数时，验证 DPG 策略梯度在真实 Q* 下收敛到 LQR 最优解
clear; clc; close all;
%% 1. 定义系统动态与代价矩阵 (Discrete-Time Linear System)
% x_{k+1} = A x_k + B u_k
A = [1.1, 0.5; 
     0.0, 0.9];
B = [0.1; 
     1.0];
C = eye(size(A));
% 代价函数矩阵 J = x'Qx + u'Ru
Q = eye(2);         % 状态代价矩阵 (Q 必须半正定)
R = 1;              % 控制代价矩阵 (R 必须正定)
%% 2. 求解真实的 LQR 最优解 (作为 Baseline)
% 使用 MATLAB 内置的 DARE (Discrete Algebraic Riccati Equation) 求解
[P_star, ~, K_lqr] = dare(A, B, Q, R);
fprintf('--- LQR 最优解 (解析解) ---\n'); %[output:9ee3eb4b]
disp('最优反馈增益 K_lqr:'); %[output:4a6a6c64]
disp(K_lqr); %[output:1a005d9c]
%% 3. DPG 策略参数初始化与超参数设定
rng(42);                        % 固定随机种子以保证结果可复现
K_dpg = rand(size(K_lqr));      % 随机初始化策略矩阵 K
learning_rate = 0.01;           % 梯度下降学习率
num_iterations = 800;           % 迭代次数
batch_size = 200;               % 每次计算梯度的采样状态数 (保证状态探索充分)
% 记录误差用于绘图
error_history = zeros(num_iterations, 1);
fprintf('--- 开始 DPG 策略梯度优化 ---\n'); %[output:0f50c31a]
%% 4. 策略梯度更新循环
for iter = 1:num_iterations
    % 假设状态分布探索充分: 从标准正态分布中采样一批状态 x_k
    % x_k 的维度为 (n_states x batch_size)
    X_batch = randn(size(A, 1), batch_size); 
    
    grad_K_accum = zeros(size(K_dpg));
    
    % 计算 Batch 内的经验策略梯度
    for i = 1:batch_size
        x_k = X_batch(:, i);
        
        % 当前策略给出的动作 u = -K * x_k
        u_k = -K_dpg * x_k  ;
        
        % 1. 计算 Q* 对 u 的梯度: \nabla_u Q^*(x_k, u)
        % 公式: 2*R*u + 2*B'*P*(A*x_k + B*u)
        grad_u_Q = 2 * R * u_k + 2 * B' * P_star * (A * x_k + B * u_k);
        
        % 2. 计算链式法则得到的策略梯度对 K 的偏导: \nabla_K J(K)
        % 因为我们要最小化代价值 (Minimize Cost)，所以直接使用你的推导公式：
        % \nabla_K C_sample = - \nabla_u Q^* * x_k'
        grad_K_sample = -grad_u_Q * x_k'; 
        
        % 累加梯度
        grad_K_accum = grad_K_accum + grad_K_sample;
    end
    
    % 取 batch 的平均梯度
    grad_K_avg = grad_K_accum / batch_size;
    
    % 梯度下降更新 K (目标是最小化 Cost)
    K_dpg = K_dpg - learning_rate * grad_K_avg;
    
    % 记录当前 K_dpg 与真实 K_lqr 的 Frobenius 范数误差
    error_history(iter) = norm(K_dpg - K_lqr, 'fro');
end
%% 5. 输出结果与可视化
fprintf('--- DPG 收敛结果 ---\n'); %[output:46586ec5]
disp('最终 DPG 学习得到的增益 K_dpg:'); %[output:5e60d361]
disp(K_dpg); %[output:2da1895e]
fprintf('K_dpg 与 K_lqr 的最终误差 (Frobenius Norm): %e\n\n', error_history(end)); %[output:6e683eac]
% 绘制收敛曲线
figure('Name', 'DPG 收敛至 LQR', 'Color', 'w'); %[output:74e42ff0]
plot(1:num_iterations, error_history, 'LineWidth', 2, 'Color', [0 0.4470 0.7410]); %[output:74e42ff0]
xlabel('迭代次数 (Iterations)', 'FontSize', 12); %[output:74e42ff0]
ylabel('误差 || K_{DPG} - K_{LQR} ||_F', 'FontSize', 12); %[output:74e42ff0]
title('DPG 策略梯度下降收敛过程', 'FontSize', 14); %[output:74e42ff0]
grid on; %[output:74e42ff0]


%[text] ## DPGandLQRsim

%%
% dpg_dlnetwork_all_dims_error.m
% 完善所有维度的误差对比与 3D 控制面可视化
clear; clc; close all;
%% 1. 系统定义与真实 LQR 解 (基准)
A_sys = [1.1, 0.5; 
         0.0, 0.9];
B_sys = [0.1; 
         1.0];
Q = eye(2);
R = 1;
[P_star, ~, K_lqr] = dare(A_sys, B_sys, Q, R);
fprintf('真实 LQR 增益 K_lqr = [%.4f, %.4f]\n', K_lqr(1), K_lqr(2)); %[output:649dda7d]
%% 2. 定义神经网络 Actor
layers = [
    featureInputLayer(2, 'Name', 'state')
    fullyConnectedLayer(16, 'Name', 'fc1')
    tanhLayer('Name', 'tanh1')
    fullyConnectedLayer(1, 'Name', 'action')
];
actorNet = dlnetwork(layers);
%% 3. 训练超参数与数据准备
num_iterations = 800;
batch_size = 256;
learning_rate = 0.02;
trailingAvg = []; trailingAvgSq = [];
% 固定的测试集，包含广泛的状态空间分布
X_test = randn(2, 500) * 2; 
u_lqr_test = -K_lqr * X_test;
% 误差追踪记录器
mse_history = zeros(num_iterations, 1);
k1_error_history = zeros(num_iterations, 1); % 维度 1 增益误差
k2_error_history = zeros(num_iterations, 1); % 维度 2 增益误差
fprintf('--- 开始训练，追踪全维度误差 ---\n'); %[output:2c19e40d]
%% 4. 自定义训练循环
for iter = 1:num_iterations %[output:group:047b0343]
    % 采样批次
    X_batch = randn(2, batch_size);
    dlX = dlarray(X_batch, 'CB'); 
    
    % 前向与反向传播 (调用已修复 stripdims 的损失函数)
    [loss, gradients] = dlfeval(@actorLoss, actorNet, dlX, A_sys, B_sys, R, P_star);
    
    % Adam 更新
    [actorNet, trailingAvg, trailingAvgSq] = adamupdate(actorNet, gradients, ...
        trailingAvg, trailingAvgSq, iter, learning_rate);
    
    % --- 误差评估区 ---
    dlX_test = dlarray(X_test, 'CB');
    U_test = extractdata(predict(actorNet, dlX_test)); 
    
    % 1. 总体 MSE 误差
    mse_history(iter) = mean((U_test - u_lqr_test).^2, 'all');
    
    % 2. 提取神经网络等效线性增益 (利用伪逆解最小二乘: U = -K * X => K = -U * pinv(X))
    K_nn_approx = -U_test * pinv(X_test);
    
    % 3. 记录各个维度的增益误差
    k1_error_history(iter) = abs(K_nn_approx(1) - K_lqr(1));
    k2_error_history(iter) = abs(K_nn_approx(2) - K_lqr(2));
    
    if mod(iter, 100) == 0
        fprintf('迭代 %d: MSE = %.2e | k1误差 = %.2e | k2误差 = %.2e\n', ... %[output:01deaefb]
            iter, mse_history(iter), k1_error_history(iter), k2_error_history(iter)); %[output:01deaefb]
    end
end %[output:group:047b0343]
fprintf('--- 训练完成 ---\n\n'); %[output:1479ee9a]
%% 5. 结果可视化：多维度收敛与 3D 控制曲面
figure('Name', 'DPG 全维度误差分析', 'Color', 'w', 'Position', [100, 100, 1200, 450]); %[output:5fb2fe8f]
% 子图 1: 各维度误差收敛曲线
subplot(1, 2, 1); %[output:5fb2fe8f]
plot(1:num_iterations, mse_history, 'k-', 'LineWidth', 2); hold on; %[output:5fb2fe8f]
plot(1:num_iterations, k1_error_history, 'r--', 'LineWidth', 1.5); %[output:5fb2fe8f]
plot(1:num_iterations, k2_error_history, 'b--', 'LineWidth', 1.5); %[output:5fb2fe8f]
xlabel('迭代次数 (Iterations)', 'FontSize', 11); %[output:5fb2fe8f]
ylabel('误差 (Absolute Error)', 'FontSize', 11); %[output:5fb2fe8f]
title('策略各维度参数收敛过程', 'FontSize', 12); %[output:5fb2fe8f]
set(gca, 'YScale', 'log'); % 对数坐标系显示微小误差 %[output:5fb2fe8f]
legend('总体动作 MSE', '状态维度1 增益误差 (|k_1^{NN} - k_1^*|)', ... %[output:5fb2fe8f]
       '状态维度2 增益误差 (|k_2^{NN} - k_2^*|)', 'Location', 'best'); %[output:5fb2fe8f]
grid on; %[output:5fb2fe8f]
% 子图 2: 3D 状态-动作控制曲面全景对比
subplot(1, 2, 2); %[output:5fb2fe8f]
[X1_grid, X2_grid] = meshgrid(linspace(-3, 3, 30), linspace(-3, 3, 30));
X_flat = [X1_grid(:)'; X2_grid(:)'];
% LQR 理论平面
U_lqr_flat = -K_lqr * X_flat;
U_lqr_grid = reshape(U_lqr_flat, size(X1_grid));
% 神经网络拟合曲面
dlX_flat = dlarray(X_flat, 'CB');
U_nn_flat = extractdata(predict(actorNet, dlX_flat));
U_nn_grid = reshape(U_nn_flat, size(X1_grid));
% 绘制 LQR 平面 (半透明灰色)
surf(X1_grid, X2_grid, U_lqr_grid, 'FaceColor', [0.5 0.5 0.5], 'FaceAlpha', 0.4, 'EdgeColor', 'none');  %[output:5fb2fe8f]
hold on; %[output:5fb2fe8f]
% 绘制 NN 曲面 (彩色线框)
mesh(X1_grid, X2_grid, U_nn_grid, 'EdgeColor', 'r', 'LineWidth', 1); %[output:5fb2fe8f]
xlabel('状态 x_1', 'FontSize', 11); %[output:5fb2fe8f]
ylabel('状态 x_2', 'FontSize', 11); %[output:5fb2fe8f]
zlabel('控制输入 u', 'FontSize', 11); %[output:5fb2fe8f]
title('全状态空间控制曲面: LQR (灰面) vs NN (红网格)', 'FontSize', 12); %[output:5fb2fe8f]
legend('LQR 解析解平面', '神经网络 Actor 曲面', 'Location', 'best'); %[output:5fb2fe8f]
view(45, 30); % 调整 3D 视角 %[output:5fb2fe8f]
grid on; %[output:5fb2fe8f]
%% 6. 自定义损失与梯度计算函数 (含 stripdims 修复)
function [loss, gradients] = actorLoss(actorNet, dlX, A, B, R, P_star)
    dlU = forward(actorNet, dlX);
    
    % 剥离维度标签进行矩阵运算
    X_unformatted = stripdims(dlX);
    U_unformatted = stripdims(dlU);
    
    dlX_next = A * X_unformatted + B * U_unformatted; 
    
    cost_U = R * (U_unformatted .* U_unformatted); 
    cost_NextState = sum(dlX_next .* (P_star * dlX_next), 1); 
    loss = mean(cost_U + cost_NextState);
    
    gradients = dlgradient(loss, actorNet.Learnables);
end
%%
% dpg_lqr_modelfree.m
% 在未知环境模型 A, B 的情况下，仅依靠奖励(代价)函数 r 学习最优控制, 不使用神经网络
clear; clc; close all;

%% 1. 环境定义 (对智能体是黑盒的)
% A = [1.1, 0.5; 
%      0.0, 0.9];
% B = [0.1; 
%      1.0];

A = [0.9955    0.0863
   -0.0863    0.7367];
B =  [0.0045
    0.0863];

C = eye(size(A));
Q = eye(2);         
R = 1;              
% 求解真实的 LQR 用于验证误差
[~, ~, K_lqr] = dare(A, B, Q, R);
fprintf('--- LQR 最优解 (Baseline) ---\n'); %[output:65fe0449]
disp(K_lqr); %[output:07bb81e0]

%% 2. Actor-Critic DPG 参数初始化
rng(42);
% Actor 初始化：在无模型RL中，通常需要一个能让系统基本不发散的初始策略(温启动)
K_actor = [1.0, 1.0]; 

% Critic 初始化：Q(x,u) = z' * H * z，由于 x 是2维，u 是1维，z 是3维
% H 是 3x3 的对称矩阵
H_critic = eye(3); 

% 学习参数设定
alpha_critic = 0.05;    % Critic 的学习率 (通常比 Actor 大，需要先验估值准确)
alpha_actor = 0.005;    % Actor 的学习率
num_epochs = 600;       % 训练轮数
batch_size = 200;       % 经验回放批次大小
gamma = 1.0;            % LQR 是无折扣问题
sigma_noise = 0.5;      % 探索噪声标准差 (极其关键！)

error_history = zeros(num_epochs, 1);
fprintf('--- 开始 Model-Free DPG 训练 ---\n'); %[output:617c2f89]

%% 3. Actor-Critic 联合优化循环
for epoch = 1:num_epochs
    
    % --- Step 1: 收集交互数据 (Experience Replay 思想) ---
    X_batch = randn(2, batch_size); 
    U_batch = zeros(1, batch_size);
    C_batch = zeros(1, batch_size);
    X_next_batch = zeros(2, batch_size);
    
    for i = 1:batch_size
        x = X_batch(:, i);
        % 执行带探索噪声的动作 (Behavior Policy)
        u_noise = -K_actor * x + sigma_noise * randn();
        
        % 与黑盒环境交互，观察代价值和下一状态
        c = x' * Q * x + u_noise' * R * u_noise; 
        x_next = A * x + B * u_noise;
        
        % 存入 Buffer
        U_batch(1, i) = u_noise;
        C_batch(1, i) = c;
        X_next_batch(:, i) = x_next;
    end
    
    % --- Step 2: 更新 Critic (Policy Evaluation, TD-Learning) ---
    % Critic 为了拟合得更准，在当前 batch 上多迭代几次
    for iter_c = 1:10 
        grad_H_accum = zeros(3, 3);
        for i = 1:batch_size
            x = X_batch(:, i);
            u = U_batch(1, i);
            c = C_batch(1, i);
            x_next = X_next_batch(:, i);
            
            z = [x; u];
            
            % 目标策略 (Target Policy): 评估当前 Actor 的纯策略 (无噪声)
            u_next = -K_actor * x_next; 
            z_next = [x_next; u_next];
            
            % 计算 TD 误差: 预测值 vs 目标值 (半梯度法，不对目标求导)
            Q_pred = z' * H_critic * z;
            Q_target = c + gamma * (z_next' * H_critic * z_next);
            delta = Q_pred - Q_target;
            
            % 累加 Critic 梯度: \nabla_H Loss = delta * z * z'
            grad_H_accum = grad_H_accum + delta * (z * z');
        end
        % 梯度下降更新 H，并强制对称化
        H_critic = H_critic - alpha_critic * (grad_H_accum / batch_size);
        H_critic = (H_critic + H_critic') / 2; 
    end
    
    % --- Step 3: 更新 Actor (Policy Improvement, DPG) ---
    grad_K_accum = zeros(1, 2);
    % 从学习到的 H 矩阵中提取分块
    H_uu = H_critic(3, 3);
    H_ux = H_critic(3, 1:2);
    
    for i = 1:batch_size
        x = X_batch(:, i);
        % DPG 计算梯度是在 当前 Actor 策略上进行的 (不带噪声)
        u_policy = -K_actor * x;
        
        % 从学到的 Critic 中计算动作梯度: \nabla_u Q(x, u)
        grad_u_Q = 2 * H_uu * u_policy + 2 * H_ux * x;
        
        % 链式法则: \nabla_K J = - \nabla_u Q * x'
        grad_K_sample = -grad_u_Q * x';
        grad_K_accum = grad_K_accum + grad_K_sample;
    end
    
    % 梯度下降更新 Actor (最小化代价值)
    K_actor = K_actor - alpha_actor * (grad_K_accum / batch_size);
    
    % 记录误差
    error_history(epoch) = norm(K_actor - K_lqr, 'fro');
end

%% 4. 输出结果与可视化
fprintf('--- DPG (Model-Free) 收敛结果 ---\n'); %[output:654c475e]
disp('最终学习得到的增益 K_actor:'); %[output:413474bc]
disp(K_actor); %[output:3d922a69]
fprintf('与理论最优 K_lqr 的最终误差: %e\n\n', error_history(end)); %[output:0175b86f]

figure('Name', 'Model-Free DPG 收敛曲线', 'Color', 'w'); %[output:19e8255f]
plot(1:num_epochs, error_history, 'LineWidth', 2, 'Color', [0.8500 0.3250 0.0980]); %[output:19e8255f]
xlabel('迭代次数 (Epochs)', 'FontSize', 12); %[output:19e8255f]
ylabel('误差 || K_{Actor} - K_{LQR} ||_F', 'FontSize', 12); %[output:19e8255f]
title('无模型 DPG (Actor-Critic) 收敛过程', 'FontSize', 14); %[output:19e8255f]
grid on; %[output:19e8255f]
%%



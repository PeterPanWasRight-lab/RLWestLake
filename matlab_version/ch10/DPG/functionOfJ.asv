%% 连续系统LQR控制策略对比分析
clear; clc; close all;

% 系统参数
A = 0.5;    % 系统矩阵
B = 1;      % 控制矩阵
x0 = 10;    % 初始状态
T = 8;      % 仿真时间（秒）
Q = 1;      % 状态代价权重
R = 1;      % 控制代价权重

% 时间向量
dt = 0.01;  % 时间步长
t = 0:dt:T; % 时间点
N = length(t);  % 时间点数量

%% 1. 计算连续时间LQR最优增益
% 求解连续时间代数Riccati方程 (CARE)
P = care(A, B, Q, R);  % 求解Riccati方程
K_opt = R\B'*P;        % 最优反馈增益 K_opt ≈1.6180

% 策略定义
K_strong = 2;  % 较强反馈增益   由于是一阶连续系统，怎么大都不会出现超调
K_con = 1.3;     % 保守反馈增益

fprintf('=== 连续系统控制策略分析 ===\n'); %[output:9275057f]
fprintf('LQR最优增益: K_opt = %.4f\n', K_opt); %[output:03e56d65]
fprintf('较强反馈增益: K_strong = %.4f\n', K_strong); %[output:450b6d9b]
fprintf('保守控制增益: K_con = %.4f\n\n', K_con); %[output:2d8b9139]

%% 2. 策略1: LQR最优控制
% 闭环系统矩阵
A_cl_opt = A - B*K_opt;

% 求解状态方程
x_opt = zeros(1, N);
u_opt = zeros(1, N);
J_opt_single = zeros(1, N);
J_opt_cum = zeros(1, N);

x_opt(1) = x0;
u_opt(1) = -K_opt * x_opt(1);
J_opt_single(1) = (x_opt(1)^2 + u_opt(1)^2) * dt;
J_opt_cum(1) = J_opt_single(1);

% 数值积分求解
for k = 2:N
    % 使用欧拉法（也可用ode45，但这里为简单用欧拉法）
    x_opt(k) = x_opt(k-1) + (A_cl_opt * x_opt(k-1)) * dt;
    u_opt(k) = -K_opt * x_opt(k);
    J_opt_single(k) = (x_opt(k)^2 + u_opt(k)^2) * dt;
    J_opt_cum(k) = J_opt_cum(k-1) + J_opt_single(k);
end

% 解析解（用于验证）
% 连续系统解析解: x(t) = x0 * exp((A-B*K_opt)*t)
t_analytic = linspace(0, T, 1000);
x_opt_analytic = x0 * exp((A - B*K_opt) * t_analytic);
u_opt_analytic = -K_opt * x_opt_analytic;

%% 3. 策略2: 较强反馈控制
A_cl_strong = A - B*K_strong;

x_strong = zeros(1, N);
u_strong = zeros(1, N);
J_strong_single = zeros(1, N);
J_strong_cum = zeros(1, N);

x_strong(1) = x0;
u_strong(1) = -K_strong * x_strong(1);
J_strong_single(1) = (x_strong(1)^2 + u_strong(1)^2) * dt;
J_strong_cum(1) = J_strong_single(1);

for k = 2:N
    x_strong(k) = x_strong(k-1) + (A_cl_strong * x_strong(k-1)) * dt;
    u_strong(k) = -K_strong * x_strong(k);
    J_strong_single(k) = (x_strong(k)^2 + u_strong(k)^2) * dt;
    J_strong_cum(k) = J_strong_cum(k-1) + J_strong_single(k);
end

%% 4. 策略3: 保守控制
A_cl_con = A - B*K_con;

x_con = zeros(1, N);
u_con = zeros(1, N);
J_con_single = zeros(1, N);
J_con_cum = zeros(1, N);

x_con(1) = x0;
u_con(1) = -K_con * x_con(1);
J_con_single(1) = (x_con(1)^2 + u_con(1)^2) * dt;
J_con_cum(1) = J_con_single(1);

for k = 2:N
    x_con(k) = x_con(k-1) + (A_cl_con * x_con(k-1)) * dt;
    u_con(k) = -K_con * x_con(k);
    J_con_single(k) = (x_con(k)^2 + u_con(k)^2) * dt;
    J_con_cum(k) = J_con_cum(k-1) + J_con_single(k);
end

%% 5. 计算开环系统响应（无控制）
% 开环系统: dx/dt = A*x, 无控制输入
x_open = x0 * exp(A * t);  % 解析解
J_open_single = x_open.^2 * dt;
J_open_cum = cumsum(J_open_single);

%% 6. 计算最终总代价（无穷时间代价的有限时间近似）
total_cost_opt = J_opt_cum(end);
total_cost_strong = J_strong_cum(end);
total_cost_con = J_con_cum(end);
total_cost_open = J_open_cum(end);

%% 7. 绘制控制输入u随时间变化，z轴为累计代价
figure('Color', 'w', 'Position', [100, 100, 1200, 900]); %[output:112bf796]

% 创建三维坐标系
ax1 = subplot(2,2,[1,3]); %[output:112bf796]
hold on; grid on; box on; %[output:112bf796]
view(45, 30); %[output:112bf796]

% 由于连续系统数据点太多，我们抽样绘制以减少绘图负担
skip = 20;  % 每隔20个点绘制一个
t_sampled = t(1:skip:end);
u_opt_sampled = u_opt(1:skip:end);
u_strong_sampled = u_strong(1:skip:end);
u_con_sampled = u_con(1:skip:end);
J_opt_cum_sampled = J_opt_cum(1:skip:end);
J_strong_cum_sampled = J_strong_cum(1:skip:end);
J_con_cum_sampled = J_con_cum(1:skip:end);

% 绘制三条控制输入轨迹
% 策略1: LQR最优 (蓝色)
plot3(t_sampled, u_opt_sampled, J_opt_cum_sampled, '-', 'Color', [0, 0.4470, 0.7410], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略1: LQR最优 (K=%.3f, J=%.2f)', K_opt, total_cost_opt)); %[output:112bf796]

% 策略2: 较强反馈 (红色)
plot3(t_sampled, u_strong_sampled, J_strong_cum_sampled, '-', 'Color', [0.8500, 0.3250, 0.0980], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略2: 较强反馈 (K=%.3f, J=%.2f)', K_strong, total_cost_strong)); %[output:112bf796]

% 策略3: 保守控制 (绿色)
plot3(t_sampled, u_con_sampled, J_con_cum_sampled, '-', 'Color', [0.4660, 0.6740, 0.1880], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略3: 保守控制 (K=%.3f, J=%.2f)', K_con, total_cost_con)); %[output:112bf796]

% 在关键时间点添加标记
key_times = [0, 1, 2, 4, 8];
for kt = 1:length(key_times)
    [~, idx] = min(abs(t - key_times(kt)));
    if idx <= length(t)
        % 策略1标记
        plot3(t(idx), u_opt(idx), J_opt_cum(idx), 'o', ... %[output:112bf796]
            'MarkerFaceColor', [0, 0.4470, 0.7410], 'MarkerEdgeColor', 'k', 'MarkerSize', 8); %[output:112bf796]
        text(t(idx), u_opt(idx), J_opt_cum(idx)+5, ...
            sprintf('t=%.1f\nu=%.2f', t(idx), u_opt(idx)), ...
            'FontSize', 8, 'HorizontalAlignment', 'center', 'Color', [0, 0.4470, 0.7410]);
        
        % 策略2标记
        plot3(t(idx), u_strong(idx), J_strong_cum(idx), 's', ...
            'MarkerFaceColor', [0.8500, 0.3250, 0.0980], 'MarkerEdgeColor', 'k', 'MarkerSize', 8);
        
        % 策略3标记
        plot3(t(idx), u_con(idx), J_con_cum(idx), '^', ...
            'MarkerFaceColor', [0.4660, 0.6740, 0.1880], 'MarkerEdgeColor', 'k', 'MarkerSize', 8);
    end
end

% 绘制零输入线
plot3([0, T], [0, 0], [0, 0], 'k--', 'LineWidth', 1.5, ... %[output:112bf796]
    'DisplayName', '零输入线 (u=0)'); %[output:112bf796]

% 添加坐标轴标签
xlabel('时间 t (秒)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
ylabel('控制输入 u(t)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
zlabel('累计代价 J_{cum}(t) = ∫_0^t (x(τ)^2+u(τ)^2)dτ', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
title('控制输入u随时间变化，z轴为累计代价', 'FontSize', 14, 'FontWeight', 'bold'); %[output:112bf796]
legend('Location', 'best', 'FontSize', 10); %[output:112bf796]
grid on; %[output:112bf796]

% 设置坐标轴范围
xlim([0, T]); %[output:112bf796]
u_max = max([abs(u_opt), abs(u_strong), abs(u_con)]);
ylim([-u_max*1.1, u_max*1.1]); %[output:112bf796]
zlim([0, max([J_opt_cum, J_strong_cum, J_con_cum])*1.1]); %[output:112bf796]

%% 8. 图2: 状态x随时间变化，z轴为累计代价
ax2 = subplot(2,2,[2,4]); %[output:112bf796]
hold on; grid on; box on; %[output:112bf796]
view(45, 30); %[output:112bf796]

% 抽样数据
x_opt_sampled = x_opt(1:skip:end);
x_strong_sampled = x_strong(1:skip:end);
x_con_sampled = x_con(1:skip:end);

% 绘制三条状态轨迹
% 策略1: LQR最优 (蓝色)
plot3(t_sampled, x_opt_sampled, J_opt_cum_sampled, '-', 'Color', [0, 0.4470, 0.7410], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略1: LQR最优 (K=%.3f, J=%.2f)', K_opt, total_cost_opt)); %[output:112bf796]

% 策略2: 较强反馈 (红色)
plot3(t_sampled, x_strong_sampled, J_strong_cum_sampled, '-', 'Color', [0.8500, 0.3250, 0.0980], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略2: 较强反馈 (K=%.3f, J=%.2f)', K_strong, total_cost_strong)); %[output:112bf796]

% 策略3: 保守控制 (绿色)
plot3(t_sampled, x_con_sampled, J_con_cum_sampled, '-', 'Color', [0.4660, 0.6740, 0.1880], ... %[output:112bf796]
    'LineWidth', 2, 'DisplayName', sprintf('策略3: 保守控制 (K=%.3f, J=%.2f)', K_con, total_cost_con)); %[output:112bf796]

% 在关键时间点添加标记
for kt = 1:length(key_times)
    [~, idx] = min(abs(t - key_times(kt)));
    if idx <= length(t)
        % 策略1标记
        plot3(t(idx), x_opt(idx), J_opt_cum(idx), 'o', ... %[output:112bf796]
            'MarkerFaceColor', [0, 0.4470, 0.7410], 'MarkerEdgeColor', 'k', 'MarkerSize', 8); %[output:112bf796]
        text(t(idx), x_opt(idx), J_opt_cum(idx)+5, ...
            sprintf('t=%.1f\nx=%.2f', t(idx), x_opt(idx)), ...
            'FontSize', 8, 'HorizontalAlignment', 'center', 'Color', [0, 0.4470, 0.7410]);
        
        % 策略2标记
        plot3(t(idx), x_strong(idx), J_strong_cum(idx), 's', ...
            'MarkerFaceColor', [0.8500, 0.3250, 0.0980], 'MarkerEdgeColor', 'k', 'MarkerSize', 8);
        
        % 策略3标记
        plot3(t(idx), x_con(idx), J_con_cum(idx), '^', ...
            'MarkerFaceColor', [0.4660, 0.6740, 0.1880], 'MarkerEdgeColor', 'k', 'MarkerSize', 8);
    end
end

% 绘制目标状态线
plot3([0, T], [0, 0], [0, 0], 'k--', 'LineWidth', 1.5, ... %[output:112bf796]
    'DisplayName', '目标状态 (x=0)'); %[output:112bf796]

% 绘制开环系统响应（无控制）
x_open_sampled = x_open(1:skip:end);
plot3(t_sampled, x_open_sampled, zeros(size(t_sampled)), 'm--', 'LineWidth', 1.5, ... %[output:112bf796]
    'DisplayName', '开环系统 (无控制)'); %[output:112bf796]

% 添加坐标轴标签
xlabel('时间 t (秒)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
ylabel('系统状态 x(t)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
zlabel('累计代价 J_{cum}(t) = ∫_0^t (x(τ)^2+u(τ)^2)dτ', 'FontSize', 12, 'FontWeight', 'bold'); %[output:112bf796]
title('系统状态x随时间变化，z轴为累计代价', 'FontSize', 14, 'FontWeight', 'bold'); %[output:112bf796]
legend('Location', 'best', 'FontSize', 10); %[output:112bf796]
grid on; %[output:112bf796]

% 设置坐标轴范围
xlim([0, T]); %[output:112bf796]
x_max = max([abs(x_opt), abs(x_strong), abs(x_con), abs(x_open)]);
ylim([-x_max*0.1, x_max*1.1]); %[output:112bf796]
zlim([0, max([J_opt_cum, J_strong_cum, J_con_cum])*1.1]); %[output:112bf796]

%% 9. 绘制二维投影对比图
figure('Color', 'w', 'Position', [200, 200, 1200, 500]); %[output:12579fa8]

% 控制输入随时间变化
subplot(1,3,1); %[output:12579fa8]
hold on; grid on; box on; %[output:12579fa8]
plot(t, u_opt, '-', 'Color', [0, 0.4470, 0.7410], 'LineWidth', 2, 'DisplayName', '策略1: LQR最优'); %[output:12579fa8]
plot(t, u_strong, '-', 'Color', [0.8500, 0.3250, 0.0980], 'LineWidth', 2, 'DisplayName', '策略2: 较强反馈'); %[output:12579fa8]
plot(t, u_con, '-', 'Color', [0.4660, 0.6740, 0.1880], 'LineWidth', 2, 'DisplayName', '策略3: 保守控制'); %[output:12579fa8]
plot([0, T], [0, 0], 'k--', 'LineWidth', 1.5, 'DisplayName', '零输入线'); %[output:12579fa8]
xlabel('时间 t (秒)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
ylabel('控制输入 u(t)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
title('控制输入随时间变化', 'FontSize', 12, 'FontWeight', 'bold'); %[output:12579fa8]
legend('Location', 'best'); %[output:12579fa8]
xlim([0, T]); %[output:12579fa8]

% 系统状态随时间变化
subplot(1,3,2); %[output:12579fa8]
hold on; grid on; box on; %[output:12579fa8]
plot(t, x_opt, '-', 'Color', [0, 0.4470, 0.7410], 'LineWidth', 2, 'DisplayName', '策略1: LQR最优'); %[output:12579fa8]
plot(t, x_strong, '-', 'Color', [0.8500, 0.3250, 0.0980], 'LineWidth', 2, 'DisplayName', '策略2: 较强反馈'); %[output:12579fa8]
plot(t, x_con, '-', 'Color', [0.4660, 0.6740, 0.1880], 'LineWidth', 2, 'DisplayName', '策略3: 保守控制'); %[output:12579fa8]
plot(t, x_open, 'm--', 'LineWidth', 1.5, 'DisplayName', '开环系统'); %[output:12579fa8]
plot([0, T], [0, 0], 'k--', 'LineWidth', 1.5, 'DisplayName', '目标状态'); %[output:12579fa8]
xlabel('时间 t (秒)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
ylabel('系统状态 x(t)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
title('系统状态随时间变化', 'FontSize', 12, 'FontWeight', 'bold'); %[output:12579fa8]
legend('Location', 'best'); %[output:12579fa8]
xlim([0, T]); %[output:12579fa8]

% 累计代价随时间变化
subplot(1,3,3); %[output:12579fa8]
hold on; grid on; box on; %[output:12579fa8]
plot(t, J_opt_cum, '-', 'Color', [0, 0.4470, 0.7410], 'LineWidth', 2, 'DisplayName', '策略1: LQR最优'); %[output:12579fa8]
plot(t, J_strong_cum, '-', 'Color', [0.8500, 0.3250, 0.0980], 'LineWidth', 2, 'DisplayName', '策略2: 较强反馈'); %[output:12579fa8]
plot(t, J_con_cum, '-', 'Color', [0.4660, 0.6740, 0.1880], 'LineWidth', 2, 'DisplayName', '策略3: 保守控制'); %[output:12579fa8]
plot(t, J_open_cum, 'm--', 'LineWidth', 1.5, 'DisplayName', '开环系统'); %[output:12579fa8]
xlabel('时间 t (秒)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
ylabel('累计代价 J_{cum}(t)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:12579fa8]
title('累计代价随时间变化', 'FontSize', 12, 'FontWeight', 'bold'); %[output:12579fa8]
legend('Location', 'northwest'); %[output:12579fa8]
xlim([0, T]); %[output:12579fa8]

% 标注最终总代价
text(T, J_opt_cum(end), sprintf('%.1f', J_opt_cum(end)), ... %[output:12579fa8]
    'FontSize', 10, 'HorizontalAlignment', 'left', 'VerticalAlignment', 'middle', 'Color', [0, 0.4470, 0.7410]); %[output:12579fa8]
text(T, J_strong_cum(end), sprintf('%.1f', J_strong_cum(end)), ... %[output:12579fa8]
    'FontSize', 10, 'HorizontalAlignment', 'left', 'VerticalAlignment', 'middle', 'Color', [0.8500, 0.3250, 0.0980]); %[output:12579fa8]
text(T, J_con_cum(end), sprintf('%.1f', J_con_cum(end)), ... %[output:12579fa8]
    'FontSize', 10, 'HorizontalAlignment', 'left', 'VerticalAlignment', 'middle', 'Color', [0.4660, 0.6740, 0.1880]); %[output:12579fa8]
text(T, J_open_cum(end), sprintf('%.1f', J_open_cum(end)), ... %[output:12579fa8]
    'FontSize', 10, 'HorizontalAlignment', 'left', 'VerticalAlignment', 'middle', 'Color', 'm'); %[output:12579fa8]

sgtitle('连续系统时间域分析：控制输入、系统状态与累计代价', 'FontSize', 16, 'FontWeight', 'bold'); %[output:12579fa8]

%% 10. 绘制闭环系统极点位置
figure('Color', 'w', 'Position', [300, 300, 800, 600]); %[output:17e6d704]
hold on; grid on; box on; %[output:17e6d704]

% 计算闭环系统极点
p_opt = A - B*K_opt;
p_strong = A - B*K_strong;
p_con = A - B*K_con;
p_open = A;  % 开环系统极点

% 绘制极点
plot(real(p_opt), imag(p_opt), 'o', 'MarkerSize', 12, 'MarkerFaceColor', [0, 0.4470, 0.7410], ... %[output:17e6d704]
    'MarkerEdgeColor', 'k', 'DisplayName', sprintf('策略1: LQR最优 (λ=%.3f)', p_opt)); %[output:17e6d704]
plot(real(p_strong), imag(p_strong), 's', 'MarkerSize', 12, 'MarkerFaceColor', [0.8500, 0.3250, 0.0980], ... %[output:17e6d704]
    'MarkerEdgeColor', 'k', 'DisplayName', sprintf('策略2: 较强反馈 (λ=%.3f)', p_strong)); %[output:17e6d704]
plot(real(p_con), imag(p_con), '^', 'MarkerSize', 12, 'MarkerFaceColor', [0.4660, 0.6740, 0.1880], ... %[output:17e6d704]
    'MarkerEdgeColor', 'k', 'DisplayName', sprintf('策略3: 保守控制 (λ=%.3f)', p_con)); %[output:17e6d704]
plot(real(p_open), imag(p_open), 'd', 'MarkerSize', 12, 'MarkerFaceColor', 'm', ... %[output:17e6d704]
    'MarkerEdgeColor', 'k', 'DisplayName', sprintf('开环系统 (λ=%.3f)', p_open)); %[output:17e6d704]

% 绘制稳定区域边界（左半平面）
plot([-5, 0], [0, 0], 'r--', 'LineWidth', 1.5, 'DisplayName', '稳定边界 (Re=0)'); %[output:17e6d704]
plot([0, 0], [-2, 2], 'r--', 'LineWidth', 1.5); %[output:17e6d704]

% 设置坐标轴
xlim([-2, 0.6]); %[output:17e6d704]
ylim([-0.5, 0.5]); %[output:17e6d704]
xlabel('实部 (Re)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:17e6d704]
ylabel('虚部 (Im)', 'FontSize', 12, 'FontWeight', 'bold'); %[output:17e6d704]
title('闭环系统极点位置', 'FontSize', 14, 'FontWeight', 'bold'); %[output:17e6d704]
legend('Location', 'best'); %[output:17e6d704]

% 填充稳定区域
fill([-5, 0, 0, -5], [-2, -2, 2, 2], [1, 0.9, 0.9], 'FaceAlpha', 0.3, 'EdgeColor', 'none'); %[output:17e6d704]
text(-1, 0.3, '稳定区域', 'FontSize', 12, 'Color', 'r', 'FontWeight', 'bold'); %[output:17e6d704]

%% 11. 输出总结信息
fprintf('=== 连续系统控制策略性能分析 ===\n'); %[output:8dbb55d4]
fprintf('策略1 (LQR最优, K=%.4f): 总代价 = %.4f\n', K_opt, total_cost_opt); %[output:6840e945]
fprintf('策略2 (较强反馈, K=%.4f): 总代价 = %.4f\n', K_strong, total_cost_strong); %[output:337473cc]
fprintf('策略3 (保守控制, K=%.4f): 总代价 = %.4f\n', K_con, total_cost_con); %[output:44f30817]
fprintf('开环系统 (无控制): 总代价 = %.4f\n\n', total_cost_open); %[output:504eeaae]

fprintf('闭环系统极点分析:\n'); %[output:4875e04e]
fprintf('策略1 (LQR最优): 闭环极点 λ = %.4f, 收敛速率 = %.4f\n', p_opt, -p_opt); %[output:20914ec0]
fprintf('策略2 (较强反馈): 闭环极点 λ = %.4f, 收敛速率 = %.4f\n', p_strong, -p_strong); %[output:5193016f]
fprintf('策略3 (保守控制): 闭环极点 λ = %.4f, 收敛速率 = %.4f\n', p_con, -p_con); %[output:172d548d]
fprintf('开环系统: 开环极点 λ = %.4f, 收敛速率 = %.4f\n\n', p_open, -p_open); %[output:540fcd30]

fprintf('最优性分析:\n'); %[output:723e519e]
fprintf('LQR最优策略的总代价最小，比策略2低 %.2f%%\n', (total_cost_strong-total_cost_opt)/total_cost_strong*100); %[output:2e4f4126]
fprintf('LQR最优策略的总代价最小，比策略3低 %.2f%%\n', (total_cost_con-total_cost_opt)/total_cost_con*100); %[output:4ada3099]
fprintf('LQR最优策略的总代价最小，比开环系统低 %.2f%%\n\n', (total_cost_open-total_cost_opt)/total_cost_open*100); %[output:04b7f78b]

fprintf('控制效果分析:\n'); %[output:9a2d8e63]
fprintf('策略1 (LQR最优): 控制力度适中，收敛平滑，代价最小\n'); %[output:67d05dd9]
fprintf('策略2 (较强反馈): 控制力度较大，收敛较快，但控制能量消耗较多\n'); %[output:9b26d062]
fprintf('策略3 (保守控制): 控制力度很小，收敛缓慢，状态误差持续存在时间长\n'); %[output:2e4bffcf]
fprintf('开环系统: 无控制，收敛最慢，代价最大\n'); %[output:99a4d42d]

%% 12. 验证解析解与数值解的一致性
figure('Color', 'w', 'Position', [400, 200, 800, 400]); %[output:9b7313c0]
subplot(1,2,1); %[output:9b7313c0]
hold on; grid on; box on; %[output:9b7313c0]
plot(t_analytic, x_opt_analytic, 'b-', 'LineWidth', 2, 'DisplayName', '解析解'); %[output:9b7313c0]
plot(t, x_opt, 'r--', 'LineWidth', 1.5, 'DisplayName', '数值解'); %[output:9b7313c0]
xlabel('时间 t (秒)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:9b7313c0]
ylabel('系统状态 x(t)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:9b7313c0]
title('LQR最优控制: 解析解与数值解对比', 'FontSize', 12, 'FontWeight', 'bold'); %[output:9b7313c0]
legend('Location', 'best'); %[output:9b7313c0]

% 计算相对误差
rel_error = abs(x_opt(1:10:end) - interp1(t_analytic, x_opt_analytic, t(1:10:end))) ./ ...
    abs(interp1(t_analytic, x_opt_analytic, t(1:10:end)));
max_rel_error = max(rel_error);

subplot(1,2,2); %[output:9b7313c0]
plot(t(1:10:end), rel_error, 'k-', 'LineWidth', 1.5); %[output:9b7313c0]
grid on; box on; %[output:9b7313c0]
xlabel('时间 t (秒)', 'FontSize', 11, 'FontWeight', 'bold'); %[output:9b7313c0]
ylabel('相对误差', 'FontSize', 11, 'FontWeight', 'bold'); %[output:9b7313c0]
title(sprintf('相对误差 (最大: %.2e)', max_rel_error), 'FontSize', 12, 'FontWeight', 'bold'); %[output:9b7313c0]

